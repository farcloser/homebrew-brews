{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>farcloser/limen#v0.1.2",
    "config:recommended",
    // Also bumps aqua_version in CI/devcontainer files, not only aqua.yaml.
    "github>aquaproj/aqua-renovate-config#2.13.0",
  ],
  // Supply-chain cooldown: wait before proposing a bump. Doubles as protection
  // against the race where a release tag exists but its assets aren't uploaded yet.
  minimumReleaseAge: "3 days",
  // `just do lint commits` enforces DCO on every PR range, bot commits included.
  commitBody: "Signed-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",
  // The update-aqua-checksum workflow pushes a fix-up commit onto Renovate's
  // branches; without this, Renovate treats the branch as human-modified and
  // stops rebasing it.
  // A formula that pins a git revision (limen.rb) is bumped to the head of
  // main by the git-refs datasource: the branch is the value, the sha the
  // digest. Branch-tracking formulas have no pin and are left alone.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^Formula/.*\\.rb$/"],
      matchStrings: [
        'url "https://github\\.com/(?<owner>[^/"]+)/(?<repo>[^/"]+)\\.git",\\s*revision: "(?<currentDigest>[0-9a-f]{40})"',
      ],
      currentValueTemplate: "main",
      depNameTemplate: "{{owner}}/{{repo}}",
      packageNameTemplate: "https://github.com/{{owner}}/{{repo}}",
      datasourceTemplate: "git-refs",
    },
  ],
  // A digest update from git-refs has no release timestamp, and the 3-day
  // cooldown above holds a timestamp-less update forever
  // (minimumReleaseAgeBehaviour defaults to timestamp-required). Our own
  // organizations' repositories are exempt from the cooldown, the same rule
  // the limen preset carries: a commit we cut carries no risk we do not
  // already own.
  packageRules: [
    {
      matchDepNames: ["/^(github\\.com/)?(farcloser|forkcloser|mycophonic)/[^/]+$/"],
      minimumReleaseAge: "0 days",
    },
  ],
  gitIgnoredAuthors: [
    "300983632+limen-ci-farcloser[bot]@users.noreply.github.com",
    "41898282+github-actions[bot]@users.noreply.github.com",
  ],
}
